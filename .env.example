# IndiaWalls AI Calling System — Environment Variables
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# Database Configuration (Supabase Cloud PostgreSQL or Local SQLite)
# ---------------------------------------------------------------------------
# If provided, call logs and chat transcripts are saved to your Supabase project.
# Leave blank to automatically use local SQLite (calls.db).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ---------------------------------------------------------------------------
# LLM Backend: "gemini" (Google AI Studio) or "groq" (Groq Cloud)
# ---------------------------------------------------------------------------
LLM_BACKEND=gemini

# Single Gemini API key:
GEMINI_API_KEY=your-gemini-api-key-here
# OR multiple keys for round-robin rotation (prevents 15 RPM / 1,500 RPD rate limit):
# GEMINI_API_KEYS=key_from_acc_1,key_from_acc_2,key_from_acc_3
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Groq (Cloud Fallback LLM / Cloud STT) — https://console.groq.com
# ---------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key-here
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

# ---------------------------------------------------------------------------
# Kokoro-82M TTS: "inproc" (Direct inside server, ultra fast) or "remote" (:8880)
# ---------------------------------------------------------------------------
KOKORO_MODE=inproc
KOKORO_TTS_URL=http://localhost:8880
KOKORO_TTS_VOICE=hf_alpha
KOKORO_TTS_SPEED=1.35

# ---------------------------------------------------------------------------
# STT Backend: "local" (IndicConformer NeMo CTC, no rate limits) or "groq"
# ---------------------------------------------------------------------------
STT_BACKEND=local
SHERPA_MODEL_DIR=models/indicconformer-hi
SHERPA_NUM_THREADS=2

# ---------------------------------------------------------------------------
# Server Network Settings
# ---------------------------------------------------------------------------
WS_HOST=0.0.0.0
WS_PORT=8765

# ---------------------------------------------------------------------------
# Admin Console Authentication (Username & Password)
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=indiawalls-secret-auth-key-change-in-production

